from ultralytics import YOLO
import cv2

# 모델 경로 (절대 경로)
model_path = 'C:/Users/choes/Desktop/line_sensing/runs/segment/train/weights/best.pt'
model = YOLO(model_path, task='segment')

# 비디오 경로 (같은 폴더에 있다면 아래처럼 절대 경로로)
video_path = 'C:/Users/choes/Desktop/line_sensing/segmentation_result2.mp4'
cap = cv2.VideoCapture(video_path)

# 비디오 저장 설정
fourcc = cv2.VideoWriter_fourcc(*'mp4v')
out = cv2.VideoWriter('output_video.mp4', fourcc, 30.0, (int(cap.get(3)), int(cap.get(4))))

while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break

    results = model(frame)
    annotated_frame = results[0].plot()

    cv2.imshow('Segmented Frame', annotated_frame)  # Colab 아님 → cv2.imshow 사용
    out.write(annotated_frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
out.release()
cv2.destroyAllWindows()
